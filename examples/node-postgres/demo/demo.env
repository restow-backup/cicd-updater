# Images of the update demo (../update-demo.sh): key:ENV_VAR:Dockerfile, built from this directory.
DEMO_PROJECT=notes
DEMO_IMAGES="app:APP_IMAGE:app/Dockerfile web:WEB_IMAGE:web/Dockerfile"
# The schema of the first install (later versions migrate through hooks.migrate).
DEMO_SETUP="run --rm -T api npm run --silent migrate"
