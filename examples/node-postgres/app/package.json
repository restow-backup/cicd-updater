{
  "name": "notes-example",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Example app updated by cicd-updater (integration level 3).",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/server.ts",
    "worker": "node src/worker.ts",
    "migrate": "node-pg-migrate up --migrations-dir migrations",
    "build:web": "esbuild src/web/admin.tsx --bundle --minify --format=esm --target=es2022 --outfile=dist/admin.js",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@restow-backup/cicd-updater": "https://github.com/restow-backup/cicd-updater/releases/download/v1.0.0/restow-backup-cicd-updater-1.0.0.tgz",
    "node-pg-migrate": "^8.0.3",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "esbuild": "^0.25.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.9.0"
  }
}
