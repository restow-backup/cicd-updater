{
  "name": "cicd-updater-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "description": "Signed, self-service updates for apps run with Docker Compose.",
  "repository": {
    "type": "git",
    "url": "https://github.com/restow-backup/cicd-updater.git"
  },
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "typecheck": "pnpm -r --workspace-concurrency=1 typecheck && tsc -p scripts/tsconfig.json && tsc -p templates/tsconfig.json && tsc -p e2e/tsconfig.json",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "generate": "tsx scripts/generate.ts",
    "check:generated": "tsx scripts/generate.ts --check",
    "build": "pnpm -r --workspace-concurrency=1 build",
    "lint:actions": "tsx scripts/lint-actions.ts",
    "bundle": "pnpm --filter @cicd-updater/release-tools build",
    "notices": "tsx scripts/third-party-notices.ts",
    "check:notices": "tsx scripts/third-party-notices.ts --check",
    "test:coverage": "vitest run --coverage",
    "e2e": "vitest run --config e2e/vitest.config.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@cicd-updater/protocol": "workspace:^",
    "@cicd-updater/release-tools": "workspace:^",
    "@cicd-updater/sidecar": "workspace:^",
    "@types/node": "^26",
    "@vitest/coverage-v8": "^5.0.3",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "fast-check": "^4.10.2",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  }
}
