        "startsAt",
        "leadSeconds",
        "startedAt",
        "finishedAt",
        "cancelled",
        "cancelledAt",
        "abortRequestedAt",
        "outcome",
        "step",
        "steps",
        "progress",
        "message",
        "failure",
        "recovery",
        "images",
        "configHash",
        "log"
