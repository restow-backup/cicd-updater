{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/restow-backup/cicd-updater/main/schemas/status.schema.json",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "instanceId": {
      "type": "string",
      "minLength": 1
    },
    "phase": {
      "type": "string",
      "enum": [
        "idle",
        "scheduled",
        "running",
        "succeeded",
        "failed"
      ]
    },
    "run": {
      "anyOf": [
        {
          "$ref": "#/$defs/Run"
        },
        {
          "type": "null"
        }
      ]
    },
    "runContext": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "previousEnv": {
              "anyOf": [
                {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {
                    "type": "object",
                    "properties": {
                      "present": {
                        "type": "boolean"
                      },
                      "line": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "value": {
                        "type": [
                          "string",
                          "null"
                        ]
                      }
                    },
                    "required": [
                      "present",
                      "line",
                      "value"
                    ],
                    "additionalProperties": false
                  }
                },
                {
                  "type": "null"
                }
              ]
            },
            "previousImages": {
              "anyOf": [
                {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                {
                  "type": "null"
                }
              ]
            },
            "baseline": {
              "type": [
                "string",
                "null"
              ]
            },
            "applyAttempted": {
              "type": "boolean"
            },
            "backupFile": {
              "type": [
                "string",
                "null"
              ]
            },
            "plan": {
              "anyOf": [
                {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {
                    "type": "object",
                    "properties": {
                      "imageKey": {
                        "type": "string"
                      },
                      "ref": {
                        "type": "string"
                      },
                      "optionalKept": {
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "imageKey",
                      "ref",
                      "optionalKept"
                    ],
                    "additionalProperties": false
                  }
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "previousEnv",
            "previousImages",
            "baseline",
            "applyAttempted",
            "backupFile",
            "plan"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "history": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/RunSummary"
      }
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/JournalEvent"
      }
    },
    "eventCounter": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "schemaVersion",
    "instanceId",
    "phase",
    "run",
    "runContext",
    "history",
    "events",
    "eventCounter"
  ],
  "additionalProperties": false,
  "title": "cicd-updater status.json (internal)",
  "$defs": {
    "Run": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^r-\\d{1,15}-[0-9a-f]{4}$"
        },
        "mode": {
          "type": "string",
          "enum": [
            "image",
            "source"
          ]
        },
        "fromVersion": {
          "type": [
            "string",
            "null"
          ]
        },
        "targetVersion": {
          "type": "string"
        },
        "targetTag": {
          "type": "string"
        },
        "notesUrl": {
          "type": [
            "string",
            "null"
          ]
        },
        "release": {
          "type": "object",
          "properties": {
            "sha256": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "channel": {
              "type": "string",
              "enum": [
                "stable",
                "beta"
              ]
            },
            "document": {
              "type": "string",
              "enum": [
                "verified",
                "not_checked"
              ]
            }
          },
          "required": [
            "sha256",
            "channel",
            "document"
          ],
          "additionalProperties": false
        },
        "trustMode": {
          "type": "string",
          "enum": [
            "keyless",
            "key",
            "none"
          ]
        },
        "verification": {
          "type": "object",
          "properties": {
            "signatures": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "verified",
                    "failed",
                    "not_checked",
                    "not_applicable"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "digests": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "verified",
                    "failed",
                    "not_applicable"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "signatures",
            "digests"
          ],
          "additionalProperties": false
        },
        "requestedBy": {
          "type": "object",
          "properties": {
            "id": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 200
                },
                {
                  "type": "null"
                }
              ]
            },
            "label": {
              "type": "string",
              "maxLength": 200
            },
            "via": {
              "type": "string",
              "enum": [
                "api",
                "cli",
                "system"
              ]
            }
          },
          "required": [
            "id",
            "label",
            "via"
          ],
          "additionalProperties": false
        },
        "scheduledAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "startsAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "leadSeconds": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "startedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
            },
            {
              "type": "null"
            }
          ]
        },
        "finishedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
            },
