{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/restow-backup/cicd-updater/main/schemas/feed-index.schema.json",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "releases": {
      "maxItems": 1000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "version": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$"
          },
          "tag": {
            "type": "string",
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,127}$"
          },
          "prerelease": {
            "type": "boolean"
          },
          "publishedAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
              },
              {
                "type": "null"
              }
            ]
          },
          "releaseJson": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000,
                "description": "https URL (static feed) or plain file name (file feed)"
              },
              {
                "type": "null"
              }
            ]
          },
          "bundle": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000,
                "description": "https URL (static feed) or plain file name (file feed)"
              },
              {
                "type": "null"
              }
            ]
          },
          "notesUrl": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2000,
                "pattern": "^https:\\/\\/"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "version",
          "tag",
          "prerelease"
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "releases"
  ],
  "title": "cicd-updater feed index"
}
